# Copier ce fichier en ".env" puis adapter les valeurs.

# Choix du moteur de stockage : "rdflib" (graphe en mémoire + fichier .owl) ou "fuseki"
SG_BACKEND=rdflib
SG_OWL_PATH=data/SmartGrid-Semantic.owl

# Apache Jena Fuseki (utilisé seulement si SG_BACKEND=fuseki)
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET=smartgrid

# Authentification (le rôle vient de la classe User : hasRole = admin | lecteur)
SG_ADMIN_PASSWORD=admin123
SG_READER_PASSWORD=lecteur123
SG_API_AUTH=true
SG_SECRET_KEY=changez-moi

# Limites
SG_MAX_RESULTS=500
