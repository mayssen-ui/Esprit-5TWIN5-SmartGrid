<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/smartgrid-semantic#"
     xml:base="http://www.semanticweb.org/smartgrid-semantic"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
  <owl:Ontology rdf:about="http://www.semanticweb.org/smartgrid-semantic">
    <rdfs:label xml:lang="fr">SmartGrid-Semantic</rdfs:label>
    <rdfs:comment xml:lang="fr">Ontologie sémantique pour la modélisation des réseaux électriques intelligents (Sujet 3 - Énergie, Validation 1, Module Web Sémantique).</rdfs:comment>
  </owl:Ontology>

  <!-- Object Properties -->
  <owl:ObjectProperty rdf:about="#produces">
    <rdfs:domain rdf:resource="#EnergySource"/>
    <rdfs:range rdf:resource="#Energy"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#consumes">
    <rdfs:domain rdf:resource="#Building"/>
    <rdfs:range rdf:resource="#Energy"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#storesEnergy">
    <rdfs:domain rdf:resource="#EnergyStorage"/>
    <rdfs:range rdf:resource="#Energy"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#connectedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:domain rdf:resource="#GridElement"/>
    <rdfs:range rdf:resource="#GridElement"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#suppliedBy">
    <rdfs:domain rdf:resource="#Building"/>
    <rdfs:range rdf:resource="#EnergySource"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#locatedIn">
    <rdfs:domain rdf:resource="#Building"/>
    <rdfs:range rdf:resource="#GridNode"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#contains">
    <rdfs:domain rdf:resource="#Substation"/>
    <rdfs:range rdf:resource="#GridNode"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasStorage">
    <rdfs:domain rdf:resource="#Building"/>
    <rdfs:range rdf:resource="#EnergyStorage"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasSource">
    <rdfs:domain rdf:resource="#GridNode"/>
    <rdfs:range rdf:resource="#EnergySource"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#feeds">
    <rdfs:domain rdf:resource="#EnergySource"/>
    <rdfs:range rdf:resource="#GridNode"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#owns">
    <rdfs:domain rdf:resource="#User"/>
    <rdfs:range rdf:resource="#Building"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#manages">
    <rdfs:domain rdf:resource="#User"/>
    <rdfs:range rdf:resource="#GridNode"/>
  </owl:ObjectProperty>

  <!-- Data Properties -->
  <owl:DatatypeProperty rdf:about="#hasName">
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#hasCapacity">
    <rdfs:domain rdf:resource="#EnergySource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#hasPowerOutput">
    <rdfs:domain rdf:resource="#EnergySource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#hasConsumption">
    <rdfs:domain rdf:resource="#Building"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#hasStorageCapacity">
    <rdfs:domain rdf:resource="#EnergyStorage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#hasEfficiency">
    <rdfs:domain rdf:resource="#EnergyStorage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#hasVoltage">
    <rdfs:domain rdf:resource="#GridElement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#hasLocation">
    <rdfs:domain rdf:resource="#GridElement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#hasInstallationDate">
    <rdfs:domain rdf:resource="#GridElement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasEmail">
    <rdfs:domain rdf:resource="#User"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#hasRole">
    <rdfs:domain rdf:resource="#User"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <!-- Classes -->
  <owl:Class rdf:about="#EnergySource">
  </owl:Class>
  <owl:Class rdf:about="#EnergyStorage">
  </owl:Class>
  <owl:Class rdf:about="#Building">
    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#consumes"/><owl:someValuesFrom rdf:resource="#Energy"/></owl:Restriction></rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#GridElement">
  </owl:Class>
  <owl:Class rdf:about="#Energy">
  </owl:Class>
  <owl:Class rdf:about="#User">
  </owl:Class>
  <owl:Class rdf:about="#SolarSource">
    <rdfs:subClassOf rdf:resource="#EnergySource"/>
    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#produces"/><owl:someValuesFrom rdf:resource="#RenewableEnergy"/></owl:Restriction></rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#WindSource">
    <rdfs:subClassOf rdf:resource="#EnergySource"/>
    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#produces"/><owl:someValuesFrom rdf:resource="#RenewableEnergy"/></owl:Restriction></rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#BatteryStorage">
    <rdfs:subClassOf rdf:resource="#EnergyStorage"/>
    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#storesEnergy"/><owl:someValuesFrom rdf:resource="#Energy"/></owl:Restriction></rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#ResidentialBuilding">
    <rdfs:subClassOf rdf:resource="#Building"/>
  </owl:Class>
  <owl:Class rdf:about="#CommercialBuilding">
    <rdfs:subClassOf rdf:resource="#Building"/>
  </owl:Class>
  <owl:Class rdf:about="#IndustrialBuilding">
    <rdfs:subClassOf rdf:resource="#Building"/>
  </owl:Class>
  <owl:Class rdf:about="#GridNode">
    <rdfs:subClassOf rdf:resource="#GridElement"/>
  </owl:Class>
  <owl:Class rdf:about="#Substation">
    <rdfs:subClassOf rdf:resource="#GridElement"/>
  </owl:Class>
  <owl:Class rdf:about="#RenewableEnergy">
    <rdfs:subClassOf rdf:resource="#Energy"/>
  </owl:Class>
  <owl:Class rdf:about="#NonRenewableEnergy">
    <rdfs:subClassOf rdf:resource="#Energy"/>
  </owl:Class>
  <!-- Classes définies -->
  <owl:Class rdf:about="#RenewableEnergySource">
    <rdfs:comment xml:lang="fr">Source d'énergie produisant une énergie renouvelable (classe définie, auxiliaire de RenewableBuilding).</rdfs:comment>
    <owl:equivalentClass><owl:Class><owl:intersectionOf rdf:parseType="Collection"><rdf:Description rdf:about="#EnergySource"/><owl:Restriction><owl:onProperty rdf:resource="#produces"/><owl:someValuesFrom rdf:resource="#RenewableEnergy"/></owl:Restriction></owl:intersectionOf></owl:Class></owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="#RenewableBuilding">
    <rdfs:comment xml:lang="fr">Bâtiment alimenté par au moins une source d'énergie renouvelable (classe définie).</rdfs:comment>
    <owl:equivalentClass><owl:Class><owl:intersectionOf rdf:parseType="Collection"><rdf:Description rdf:about="#Building"/><owl:Restriction><owl:onProperty rdf:resource="#suppliedBy"/><owl:someValuesFrom rdf:resource="#RenewableEnergySource"/></owl:Restriction></owl:intersectionOf></owl:Class></owl:equivalentClass>
  </owl:Class>
  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="#EnergySource"/>
      <rdf:Description rdf:about="#EnergyStorage"/>
      <rdf:Description rdf:about="#Building"/>
      <rdf:Description rdf:about="#GridElement"/>
      <rdf:Description rdf:about="#Energy"/>
      <rdf:Description rdf:about="#User"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:Class rdf:about="#RenewableEnergy"><owl:disjointWith rdf:resource="#NonRenewableEnergy"/></owl:Class>

